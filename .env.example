# Persistent disk. auto-start.sh auto-detects /workspace, /root/volume, /runpod-volume, /mnt/data, /volume.
# VOLUME_ROOT=/workspace

# Worker startup mode:
# - none  = Flask bridge only (clean boot, no ComfyUI)
# - comfy = Flask bridge + ComfyUI on COMFY_PORT
AUTOSTART_MODE=none

# Native Vast (no Docker): use bash start-vast-native.sh instead of auto-start.sh
# FLASK_PORT=3000
# WORKER_CONTROL=1

# Run bootstrap.sh on start (ComfyUI install, folders, optional model downloads).
BOOTSTRAP=0

# Model sets for bootstrap when BOOTSTRAP=1. Use none for install-only (no downloads).
# Examples: none, basic, all, all,flux_user, all,flux_user,hf_loras
MODEL_SET=none

# ComfyUI + Flask ports inside the Vast machine.
COMFY_PORT=8188
UI_PORT=3000
COMFY_URL=http://127.0.0.1:8188

# Docker image for the Flask bridge runtime. Default builds locally from this repo.
IMAGE=docker3000_script:local
CONTAINER_NAME=muse-flask-3000
BUILD_IMAGE=1
PULL_IMAGE=0

# Optional Flask basic auth.
# APP_PASSWORD=
# UI_PASSWORD=

# Optional tokens for model downloads (never commit real values).
# HF_TOKEN=
# CIVITAI_TOKEN=

# Self-hosted LLM (llama-server on LLM_PORT, default 8080). Overrides llm_models.json ctx_size.
# LLM_PORT=8080
# LLAMA_CTX_SIZE=32768   # e.g. raise Qwen3 14B on 5080; do not blindly set on 35B/Gemma (VRAM)
# LLM_CTX_SIZE=32768
